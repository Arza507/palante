# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.

# Módulo 2: clave de la API de Anthropic, con límite de gasto mensual configurado en la consola.
ANTHROPIC_API_KEY=
# Tope de gasto en dólares para una corrida de extracción de ofertas.
MAX_USD_EMPLEO=2

# Web
# URL pública del sitio (para URL canónicas, sitemap e imágenes para compartir).
PUBLIC_SITE_URL=https://palante.pages.dev
# Correo de contacto que se muestra en /acerca. Vacío: se muestra el enlace al repositorio.
PUBLIC_CONTACTO_EMAIL=
# Token de Cloudflare Web Analytics (sin cookies). Vacío: sin analítica.
PUBLIC_CF_BEACON_TOKEN=
# Muestra la página de rutas. Solo "true" cuando exista al menos una ruta real validada.
PUBLIC_RUTAS=false
# URL del archivo PMTiles de Panamá en Cloudflare R2. Vacío: rutas sobre fondo liso.
PUBLIC_PMTILES_URL=
