---
// Barras horizontales en SVG generadas en el build, con nombre y valor en texto.
import Icono from './Icono.astro';
import { numero } from '../lib/formato';
import { ESTILO_CATEGORIA } from '../lib/m311';

interface Props { items: { id: string; nombre: string; n: number }[]; titulo: string }
const { items, titulo } = Astro.props;
const max = Math.max(1, ...items.map((i) => i.n));
---
<ul class="barras" aria-label={titulo}>
  {items.map((i) => {
    const e = ESTILO_CATEGORIA[i.id] ?? ESTILO_CATEGORIA.otros;
    return (
      <li>
        <span class="chip" style={`background:${e.color}`}><Icono nombre={e.icono} />{i.nombre}</span>
        <svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
          <rect x="0" y="1" width={(i.n / max) * 100} height="8" fill={e.color} stroke="#2A2623" stroke-width=".4" vector-effect="non-scaling-stroke"></rect>
        </svg>
        <span class="num">{numero(i.n)}</span>
      </li>
    );
  })}
</ul>
